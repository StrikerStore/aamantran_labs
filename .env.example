# ── Aamantran Template Lab ────────────────────────────────────────────────
# Vite bakes these in at BUILD time, not runtime. Changing one means a rebuild
# and redeploy — setting it on the host after the fact does nothing.

# Backend API origin, no trailing slash.
# Local dev: leave unset so Vite proxies /api/dev to localhost:4000.
# Production: VITE_API_URL=https://api.aamantran.online
# VITE_API_URL=

# Where guest invitations are served (backend /i/:slug). This is the URL a
# developer copies and the one encoded into the QR code, so it must be
# reachable from a phone — a localhost value cannot be.
# Local dev: leave unset to use the Vite proxy (same origin).
# Production: VITE_PUBLIC_INVITE_BASE_URL=https://api.aamantran.online
# VITE_PUBLIC_INVITE_BASE_URL=
